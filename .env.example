# Copy this file to .env for local Windows development.
# Keep the real file out of git and never commit these values.
NEON_DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/database?sslmode=require
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
ADMIN_CLERK_USER_ID=user_replace_me

# Vite only exposes variables prefixed with VITE_. You can either duplicate
# the publishable key here or let the Replit Vite config read CLERK_PUBLISHABLE_KEY.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Used by local commands that are not launched through the Replit artifact runner.
PORT=8080
BASE_PATH=/